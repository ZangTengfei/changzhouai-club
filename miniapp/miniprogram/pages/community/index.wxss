.community-page {
  padding-top: 22rpx;
  padding-bottom: 96rpx;
}

.community-hero {
  position: relative;
  display: flex;
  min-height: 590rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 38rpx;
  background: #f3f8fd;
  box-shadow: 0 16rpx 38rpx rgba(45, 93, 139, 0.12);
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  width: 52%;
  box-sizing: border-box;
  flex: none;
  flex-direction: column;
  padding: 32rpx 24rpx 28rpx 30rpx;
}

.hero-topline,
.hero-location,
.hero-tags,
.hero-stats {
  display: flex;
  align-items: center;
}

.hero-topline {
  gap: 10rpx;
  color: #0f2240;
  font-size: 19rpx;
  font-weight: 780;
  white-space: nowrap;
}

.hero-topline image {
  width: 39rpx;
  height: 39rpx;
  flex: none;
}

.hero-title {
  display: flex;
  margin-top: 30rpx;
  color: #0e2446;
  font-size: 40rpx;
  font-weight: 850;
  flex-direction: column;
  line-height: 1.28;
}

.hero-title text {
  white-space: nowrap;
}

.hero-copy {
  display: block;
  margin-top: 20rpx;
  color: #657284;
  font-size: 21rpx;
  line-height: 1.55;
}

.hero-location {
  align-items: flex-start;
  gap: 9rpx;
  margin-top: 22rpx;
  color: #35465a;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1.5;
}

.hero-location image {
  width: 26rpx;
  height: 26rpx;
  flex: none;
  margin-top: 1rpx;
}

.hero-stats {
  margin-top: auto;
  padding-top: 22rpx;
  border-top: 2rpx solid #dce8f3;
}

.hero-stat {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
  padding: 0 12rpx;
  border-right: 2rpx solid #dce8f3;
}

.hero-stat:first-child {
  padding-left: 0;
}

.hero-stat:last-child {
  padding-right: 0;
  border-right: 0;
}

.hero-stat text:first-child {
  color: #1f68d5;
  font-size: 38rpx;
  font-weight: 820;
  line-height: 1.15;
}

.hero-stat text:last-child {
  color: #5f6d7c;
  font-size: 18rpx;
}

.hero-tags {
  gap: 8rpx;
  margin-top: 18rpx;
}

.hero-tags text {
  padding: 7rpx 11rpx;
  border-radius: 16rpx;
  background: #e4effb;
  color: #244c7d;
  font-size: 16rpx;
  font-weight: 700;
  white-space: nowrap;
}

.hero-photo {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  width: 52%;
  overflow: hidden;
  border-radius: 48rpx 0 0 0;
  transform: skewX(-6deg);
  transform-origin: right bottom;
}

.hero-photo-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: auto;
  height: 100%;
  transform: skewX(6deg) scale(1.04);
  transform-origin: right center;
}

.hero-photo-entry {
  position: absolute;
  right: 16rpx;
  bottom: 20rpx;
  display: flex;
  min-height: 54rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 7rpx;
  padding: 0 17rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  background: rgba(19, 34, 51, 0.66);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 720;
  white-space: nowrap;
  box-shadow: 0 8rpx 18rpx rgba(14, 36, 59, 0.16);
  transform: skewX(6deg);
  transform-origin: center;
}

.hero-photo-entry text:last-child {
  font-size: 25rpx;
  line-height: 1;
}

.community-section-heading {
  align-items: flex-end;
  margin-top: 54rpx;
}

.community-section-heading > view:first-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.community-section-heading .section-title {
  font-size: 36rpx;
  line-height: 1.32;
}

.section-eyebrow {
  color: var(--color-green-dark);
  font-size: 18rpx;
  font-weight: 780;
  letter-spacing: 1.5rpx;
}

.section-side-note {
  padding-bottom: 4rpx;
  color: var(--color-subtle);
  font-size: 21rpx;
  white-space: nowrap;
}

.opc-card {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 12rpx 26rpx;
}

.opc-point {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-line);
}

.opc-point:last-child {
  border-bottom: 0;
}

.opc-icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.opc-icon image {
  width: 48rpx;
  height: 48rpx;
}

.opc-point > view:last-child {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.opc-point > view:last-child text:first-child {
  font-size: 29rpx;
  font-weight: 790;
}

.opc-point > view:last-child text:last-child {
  color: var(--color-subtle);
  font-size: 22rpx;
  line-height: 1.5;
}

.booking-card {
  padding: 24rpx;
}

.resource-segmented {
  margin-bottom: 22rpx;
}

.desk-permanent-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f3f8fc;
}

.desk-permanent-status-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
}

.desk-permanent-status-copy text:first-child {
  font-size: 23rpx;
  font-weight: 780;
}

.desk-permanent-status-copy text:last-child {
  color: var(--color-subtle);
  font-size: 18rpx;
  line-height: 1.45;
}

.date-scroller {
  width: 100%;
  margin: 0 -2rpx;
  white-space: nowrap;
}

.date-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 2rpx 12rpx;
}

.date-chip {
  display: flex;
  box-sizing: border-box;
  min-width: 104rpx;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 22rpx;
  background: #ffffff;
}

.date-chip text:first-child {
  font-size: 23rpx;
  font-weight: 740;
}

.date-chip text:last-child {
  color: var(--color-subtle);
  font-size: 19rpx;
}

.date-chip-active {
  border-color: var(--color-green);
  background: var(--color-green-soft);
  color: var(--color-green-dark);
}

.date-chip-active text:last-child {
  color: var(--color-green-dark);
}

.time-controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 10rpx;
}

.time-picker,
.attendee-picker {
  display: flex;
  min-height: 86rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 24rpx;
}

.time-picker text:first-child,
.attendee-picker text:first-child {
  color: var(--color-subtle);
}

.time-picker text:last-child,
.attendee-picker text:last-child {
  color: var(--color-green-dark);
  font-weight: 780;
}

.duration-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.control-label {
  color: var(--color-subtle);
  font-size: 22rpx;
}

.duration-row {
  display: flex;
  gap: 10rpx;
}

.duration-chip {
  display: flex;
  min-height: 66rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-line);
  border-radius: 22rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 680;
}

.duration-chip-active {
  border-color: var(--color-green);
  background: var(--color-green-soft);
  color: var(--color-green-dark);
}

.availability-strip {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #f5f8f6;
}

.availability-strip > view {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.availability-strip > view text:first-child {
  color: var(--color-green-dark);
  font-size: 36rpx;
  font-weight: 820;
}

.availability-strip > view text:last-child,
.availability-strip > text:last-child {
  color: var(--color-subtle);
  font-size: 20rpx;
}

.availability-strip > text:last-child {
  text-align: right;
}

.space-warning,
.space-loading {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: var(--color-orange-soft);
  color: #8a4d1c;
  font-size: 20rpx;
}

.space-warning text:last-child {
  color: var(--color-orange);
  font-weight: 760;
}

.space-loading {
  justify-content: center;
  background: var(--color-green-soft);
  color: var(--color-green-dark);
}

.map-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.mini-segmented {
  display: flex;
  padding: 5rpx;
  border-radius: 20rpx;
  background: #eef2f0;
}

.mini-segmented view {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: var(--color-subtle);
  font-size: 21rpx;
  font-weight: 680;
}

.mini-segmented .active {
  background: #ffffff;
  color: var(--color-ink);
  box-shadow: 0 6rpx 14rpx rgba(31, 55, 45, 0.08);
}

.map-reset {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  padding: 0 18rpx;
  color: var(--color-green-dark);
  font-size: 21rpx;
  font-weight: 720;
}

.map-section {
  margin-top: 14rpx;
}

.space-map-viewport {
  width: 100%;
  height: 760rpx;
  overflow: hidden;
  border: 2rpx solid #dce6e1;
  border-radius: 28rpx;
  background: #e8efeb;
}

.space-map {
  width: 100%;
  height: 100%;
}

.floor-shell {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border: 8rpx solid #2e3c36;
  border-radius: 18rpx;
  background: #f8f6ef;
  box-shadow: 0 16rpx 34rpx rgba(31, 50, 43, 0.14);
}

.floor-window {
  position: absolute;
  z-index: 1;
  border: 7rpx solid #b7dbe5;
  background: rgba(219, 241, 246, 0.5);
}

.floor-window-left {
  top: 7%;
  bottom: 18%;
  left: -4rpx;
  border-top: 0;
  border-bottom: 0;
}

.floor-window-top {
  top: -4rpx;
  right: 7%;
  left: 6%;
  border-right: 0;
  border-left: 0;
}

.static-room {
  position: absolute;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #52625b;
  border-radius: 9rpx;
  background: #eee7da;
  color: #5e6864;
  font-size: 20rpx;
  font-weight: 720;
}

.office-room {
  top: 2.5%;
  width: 20%;
  height: 13%;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 6rpx;
  font-size: 17rpx;
  line-height: 1.2;
}

.office-room-one {
  left: 48%;
}

.office-room-two {
  left: 70%;
}

.focused-office-zone {
  top: 31%;
  left: 68%;
  width: 25%;
  height: 22%;
  flex-direction: column;
  justify-content: flex-start;
  gap: 2rpx;
  padding-top: 10rpx;
  border-color: #9ba7a2;
  background: #e8ecea;
  font-size: 18rpx;
}

.focused-office-zone text:first-child {
  width: 100%;
  box-sizing: border-box;
  padding: 0 4rpx;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
}

.salon-zone {
  top: 31%;
  left: 45%;
  width: 18%;
  height: 34%;
  border-color: #b8c4be;
  background: #eef4ef;
}

.hall-label {
  position: absolute;
  top: 11.5%;
  left: 8%;
  color: #7d8883;
  font-size: 16rpx;
  font-weight: 720;
}

.entrance-label {
  position: absolute;
  right: 12%;
  bottom: 2%;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  background: #2f453c;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 720;
}

.map-resource {
  position: absolute;
  z-index: 4;
  display: flex;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 4rpx;
  border: 3rpx solid transparent;
  border-radius: 10rpx;
  background: #ffffff;
  color: #244b3a;
  font-size: 15rpx;
  font-weight: 780;
  line-height: 1.1;
  box-shadow: 0 5rpx 12rpx rgba(37, 64, 52, 0.12);
}

.map-resource::after {
  border: 0;
}

.map-resource-desk::before {
  position: absolute;
  top: 6rpx;
  right: 18%;
  left: 18%;
  height: 24%;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
  opacity: 0.22;
}

.desk-facing-south::before {
  top: auto;
  bottom: 6rpx;
}

.map-resource-meeting_room {
  border-width: 5rpx;
  border-radius: 13rpx;
  font-size: 23rpx;
  box-shadow: inset 0 0 0 7rpx rgba(255, 255, 255, 0.6), 0 8rpx 18rpx rgba(37, 64, 52, 0.12);
}

.room-capacity {
  margin-top: 6rpx;
  font-size: 17rpx;
  font-weight: 620;
  opacity: 0.72;
}

.resource-available {
  border-color: #27b574;
  background: #e9f9f0;
  color: #08794a;
}

.resource-booked {
  border-color: #efa35f;
  background: #fff2e5;
  color: #9b581d;
}

.resource-fixed {
  border-color: #9ba7a2;
  background: #e8ecea;
  color: #68736f;
}

.map-resource-assigned::before {
  display: none;
}

.fixed-resource-code {
  font-size: 15rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.fixed-resource-status {
  margin-top: 3rpx;
  color: #7d8783;
  font-size: 10rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.resource-disabled {
  border-color: #cbd3cf;
  background: #f1f3f2;
  color: #919b97;
}

.map-resource-muted {
  opacity: 0.44;
}

.map-resource-selected {
  z-index: 6;
  border-color: #2f80ed;
  box-shadow: 0 0 0 7rpx rgba(47, 128, 237, 0.18), 0 8rpx 18rpx rgba(37, 64, 52, 0.16);
}

.mine-dot {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  padding: 4rpx 8rpx;
  border-radius: 12rpx;
  background: var(--color-blue);
  color: #ffffff;
  font-size: 13rpx;
  font-weight: 700;
}

.map-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 16rpx;
}

.map-legend view {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: var(--color-subtle);
  font-size: 18rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid;
  border-radius: 5rpx;
}

.legend-dot.available {
  border-color: #27b574;
  background: #e9f9f0;
}

.legend-dot.booked {
  border-color: #efa35f;
  background: #fff2e5;
}

.legend-dot.fixed {
  border-color: #9ba7a2;
  background: #e8ecea;
}

.map-tip {
  display: block;
  margin-top: 12rpx;
  color: var(--color-subtle);
  font-size: 18rpx;
  line-height: 1.45;
}

.resource-list {
  margin-top: 16rpx;
}

.desk-resource-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.resource-list-item {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 20rpx;
  background: #ffffff;
}

.desk-resource-list .resource-list-item {
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  align-items: stretch;
  padding: 15rpx;
}

.resource-list-item > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.resource-list-item > view text:first-child {
  font-size: 23rpx;
  font-weight: 760;
}

.resource-list-item > view text:last-child,
.resource-list-item > text:last-child {
  color: var(--color-subtle);
  font-size: 18rpx;
}

.room-resource-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.resource-list-item-available {
  border-color: #b9e7cf;
  background: var(--color-green-soft);
}

.resource-list-item-booked {
  border-color: #f2d3b4;
  background: var(--color-orange-soft);
}

.resource-list-item-fixed,
.resource-list-item-disabled {
  background: #f1f3f2;
  opacity: 0.74;
}

.fixed-list-assignee {
  display: flex;
  min-width: 0;
  flex-direction: row !important;
  align-items: center;
  gap: 8rpx !important;
}

.fixed-list-assignee image {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #ffffff;
}

.fixed-list-assignee text {
  overflow: hidden;
  font-size: 22rpx !important;
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource-list-item-selected {
  border-color: var(--color-blue);
  box-shadow: 0 0 0 5rpx rgba(47, 128, 237, 0.12);
}

.selection-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 2rpx solid #c9e3d5;
  border-radius: 26rpx;
  background: #f5fbf7;
}

.selection-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.selection-heading > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7rpx;
}

.selection-heading > view text:first-child {
  font-size: 30rpx;
  font-weight: 800;
}

.selection-heading > view text:last-child {
  color: var(--color-subtle);
  font-size: 20rpx;
  line-height: 1.45;
}

.booking-field,
.access-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 20rpx;
}

.booking-field > text,
.access-field > text {
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 680;
}

.booking-field input,
.access-field input,
.access-field textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 24rpx;
}

.access-field textarea {
  min-height: 148rpx;
  padding-top: 18rpx;
  line-height: 1.5;
}

.attendee-picker {
  margin-top: 16rpx;
}

.booking-submit {
  margin-top: 22rpx;
}

.selection-status-booked {
  background: var(--color-orange-soft);
  color: #9a571f;
}

.desk-use-prompt {
  display: block;
  margin-top: 22rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 700;
}

.desk-use-options {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.desk-use-option {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 5rpx;
  margin: 0;
  padding: 14rpx 12rpx;
  border: 2rpx solid #d6e1dc;
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--color-ink);
  line-height: 1.3;
  text-align: left;
}

.desk-use-option::after {
  border: 0;
}

.desk-use-option text:first-child {
  font-size: 22rpx;
  font-weight: 780;
  white-space: nowrap;
}

.desk-use-option text:last-child {
  color: var(--color-subtle);
  font-size: 17rpx;
}

.desk-use-option-selected {
  border-color: var(--color-green);
  background: var(--color-green-soft);
  color: var(--color-green-dark);
}

.desk-use-option-selected text:last-child {
  color: var(--color-green-dark);
}

.desk-use-option-disabled {
  opacity: 0.5;
}

.desk-use-action,
.desk-fixed-form {
  margin-top: 4rpx;
}

.desk-fixed-intro {
  display: block;
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1.55;
}

.booking-note {
  display: block;
  margin-top: 14rpx;
  color: var(--color-subtle);
  font-size: 18rpx;
  line-height: 1.5;
}

.fixed-desk-consent {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1.55;
}

.fixed-desk-consent checkbox {
  flex: 0 0 auto;
  transform: scale(0.86);
  transform-origin: top left;
}

.fixed-desk-submit {
  margin-top: 22rpx;
}

.fixed-desk-active-avatar {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: var(--color-green-soft);
  color: var(--color-green-dark);
  font-size: 28rpx;
  font-weight: 780;
}

.fixed-desk-active-avatar image {
  width: 100%;
  height: 100%;
}

.fixed-desk-release {
  display: inline-flex;
  width: 108rpx;
  max-width: 108rpx;
  min-width: 0;
  min-height: 54rpx;
  box-sizing: border-box;
  flex: 0 0 108rpx;
  align-items: center;
  align-self: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #d9e2df;
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #7b4a43;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.fixed-desk-release::after {
  border: 0;
}

.fixed-desk-review-note {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #f1d6b8;
  border-radius: 18rpx;
  background: var(--color-orange-soft);
  color: #8a4d1c;
}

.fixed-desk-review-note text:first-child {
  font-size: 21rpx;
  font-weight: 760;
}

.fixed-desk-review-note text:last-child {
  font-size: 18rpx;
  line-height: 1.5;
}

.my-bookings {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.my-booking-card {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
}

.booking-date-tile {
  display: flex;
  min-width: 144rpx;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background: var(--color-green-soft);
  color: var(--color-green-dark);
}

.booking-date-tile text:first-child {
  font-size: 22rpx;
  font-weight: 780;
}

.booking-date-tile text:last-child {
  font-size: 18rpx;
}

.my-booking-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.my-booking-copy text:first-child {
  font-size: 25rpx;
  font-weight: 760;
}

.my-booking-copy text:last-child {
  color: var(--color-subtle);
  font-size: 20rpx;
}

.booking-cancel {
  width: auto;
  min-width: 92rpx;
  min-height: 62rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 31rpx;
  background: #f3f5f4;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 62rpx;
}

.booking-cancel::after {
  border: 0;
}

.booking-cancelled {
  color: var(--color-subtle);
  font-size: 20rpx;
}

.access-card {
  padding: 26rpx;
}

.access-intro {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.access-icon {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  background: var(--color-green-soft);
}

.access-icon image {
  width: 48rpx;
  height: 48rpx;
}

.access-intro > view:last-child {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.access-intro > view:last-child text:first-child {
  font-size: 27rpx;
  font-weight: 780;
}

.access-intro > view:last-child text:last-child {
  color: var(--color-subtle);
  font-size: 21rpx;
  line-height: 1.5;
}

.access-status {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--color-green-soft);
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.access-status-processed {
  background: var(--color-blue-soft);
}

.access-submit {
  margin-top: 22rpx;
}

.community-footer {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-top: 58rpx;
  padding: 30rpx 0 10rpx;
  border-top: 2rpx solid var(--color-line);
  color: var(--color-subtle);
  font-size: 20rpx;
  text-align: center;
}

.community-footer text:first-child {
  color: var(--color-green-dark);
  font-size: 26rpx;
  font-weight: 780;
}
