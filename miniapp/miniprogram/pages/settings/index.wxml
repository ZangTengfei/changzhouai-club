<view class="page-shell settings-page">
  <view wx:if="{{loading}}" class="empty-state loading-state"><view class="loading-spinner" aria-hidden="true"></view><text>正在加载设置</text></view>
  <view wx:elif="{{loadFailed}}" class="empty-state" bindtap="loadSettings">设置加载失败，轻触重试</view>

  <block wx:else>
    <view class="settings-group">
      <text class="settings-group-title">个人信息</text>
      <view class="settings-list">
        <view class="settings-row avatar-row">
          <image wx:if="{{user.avatarUrl}}" class="settings-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="settings-avatar settings-avatar-empty">{{avatarInitial}}</view>
          <view class="settings-copy"><text class="settings-label">头像</text><text class="settings-description">用于社区账号和报名展示</text></view>
          <button class="settings-action-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" loading="{{avatarUploading}}" disabled="{{avatarUploading}}" hover-class="none">更换</button>
        </view>
        <view wx:if="{{nameEditing}}" class="settings-row nickname-edit-row">
          <image class="settings-icon" src="/assets/icons/profile-blue-v2.png" mode="aspectFit" />
          <view class="nickname-inline-field">
            <text class="nickname-inline-label">昵称</text>
            <input class="nickname-inline-input" type="nickname" maxlength="60" value="{{displayNameDraft}}" bindinput="handleNameInput" bindblur="handleNameBlur" confirm-type="done" bindconfirm="saveDisplayName" focus />
          </view>
          <view class="nickname-inline-actions" bindtouchstart="prepareNameEditAction" bindtouchcancel="cancelNameEditAction">
            <text class="nickname-inline-cancel" catchtap="cancelNameEdit">取消</text>
            <text class="nickname-inline-save" catchtap="saveDisplayName">{{displayNameSaving ? '保存中' : '保存'}}</text>
          </view>
        </view>
        <view wx:else class="settings-row" bindtap="openNameEditor" role="button" aria-label="修改昵称">
          <image class="settings-icon" src="/assets/icons/profile-blue-v2.png" mode="aspectFit" />
          <view class="settings-copy"><text class="settings-label">昵称</text><text class="settings-description">{{user.displayName || '未设置昵称'}}</text></view>
          <image class="settings-arrow" src="/assets/icons/chevron-soft-v2.png" mode="aspectFit" />
        </view>
        <view class="settings-row phone-row">
          <image class="settings-icon" src="/assets/icons/privacy-green-v2.png" mode="aspectFit" />
          <view class="settings-copy"><text class="settings-label">手机号</text><text class="settings-description">{{phoneBound ? phoneMasked + ' · 仅用于必要联系' : '微信授权获取，仅用于必要联系'}}</text></view>
          <button wx:if="{{user.privacyAccepted}}" class="phone-status" open-type="getPhoneNumber" bindgetphonenumber="bindPhoneNumber" loading="{{phoneBinding}}" disabled="{{phoneBinding}}" hover-class="none">{{phoneBound ? '重新绑定' : '去绑定'}}</button>
          <button wx:else class="phone-status" bindtap="preparePhoneBinding" hover-class="none">{{phoneBound ? '重新绑定' : '去绑定'}}</button>
        </view>
        <view class="settings-row" bindtap="openPrivacy" role="button">
          <image class="settings-icon" src="/assets/icons/privacy-green-v2.png" mode="aspectFit" />
          <text class="settings-label">隐私说明</text>
          <image class="settings-arrow" src="/assets/icons/chevron-soft-v2.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="settings-group">
      <view class="settings-group-heading"><text class="settings-group-title">账号连接</text><text class="settings-count">{{linkedChannels.length}} 项</text></view>
      <view class="settings-list">
        <view wx:for="{{linkedChannels}}" wx:key="*this" class="settings-row connection-row">
          <image class="settings-icon" src="/assets/icons/link-purple-v2.png" mode="aspectFit" />
          <text class="settings-label">{{item}}</text>
          <text class="connection-status">已连接</text>
        </view>
        <view wx:if="{{accountRecoveryAvailable}}" class="settings-row recovery-row" bindtap="openAccountRecovery" role="button" aria-label="通过邮箱找回旧账号">
          <image class="settings-icon" src="/assets/icons/link-purple-v2.png" mode="aspectFit" />
          <view class="settings-copy"><text class="settings-label">找回旧账号</text><text class="settings-description">曾用 Google 或邮箱登录</text></view>
          <image class="settings-arrow" src="/assets/icons/chevron-soft-v2.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <button class="logout-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleLogout">
      <image src="/assets/icons/logout-orange-v2.png" mode="aspectFit" />
      <text>退出当前账号</text>
    </button>
  </block>
</view>
