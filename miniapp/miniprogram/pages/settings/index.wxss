.settings-page {
  padding-top: 26rpx;
}

.settings-group {
  margin-top: 20rpx;
}

.settings-group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.settings-group-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 790;
}

.settings-count {
  margin-bottom: 16rpx;
  color: var(--color-subtle);
  font-size: 22rpx;
}

.settings-list {
  overflow: hidden;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.settings-row {
  display: flex;
  min-height: 106rpx;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--color-line);
}

.settings-row:last-child {
  border-bottom: 0;
}

.phone-row {
  box-sizing: border-box;
  width: 100%;
}

.settings-avatar {
  display: flex;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: var(--color-green-soft);
}

.settings-avatar-empty {
  color: var(--color-green-dark);
  font-size: 26rpx;
  font-weight: 800;
}

.settings-action-button {
  display: flex;
  box-sizing: border-box;
  width: 96rpx;
  min-width: 96rpx;
  min-height: 56rpx;
  flex: 0 0 96rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: transparent;
  color: var(--color-green-dark);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.settings-action-button::after {
  border: 0;
}

.phone-status {
  display: flex;
  box-sizing: border-box;
  width: 128rpx;
  min-width: 128rpx;
  min-height: 56rpx;
  flex: 0 0 128rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background-color: transparent;
  color: var(--color-green-dark);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.phone-status::after {
  border: 0;
}

.settings-icon {
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  padding: 14rpx;
  border-radius: 20rpx;
  background: var(--color-blue-soft);
}

.connection-row .settings-icon,
.recovery-row .settings-icon {
  background: var(--color-purple-soft);
}

.settings-label {
  min-width: 0;
  flex: 1;
  font-size: 27rpx;
  font-weight: 680;
}

.settings-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
}

.settings-description {
  color: var(--color-subtle);
  font-size: 21rpx;
}

.settings-copy .settings-label {
  flex: 0 0 auto;
}

.settings-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
}

.connection-status {
  padding: 5rpx 13rpx;
  border-radius: 18rpx;
  background: var(--color-green-soft);
  color: var(--color-green-dark);
  font-size: 21rpx;
  font-weight: 700;
}

.logout-button {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 42rpx;
  border: 2rpx solid #ffd9d2;
  border-radius: 46rpx;
  background: #fff3f0;
  color: #bf3e2e;
  font-size: 27rpx;
  font-weight: 700;
}

.logout-button::after {
  border: 0;
}

.logout-button image {
  width: 34rpx;
  height: 34rpx;
}

.nickname-edit-row {
  min-height: 120rpx;
}

.nickname-inline-field {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.nickname-inline-label {
  color: var(--color-subtle);
  font-size: 19rpx;
  font-weight: 680;
  line-height: 1.4;
}

.nickname-inline-input {
  width: 100%;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 54rpx;
}

.nickname-inline-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 12rpx;
}

.nickname-inline-cancel,
.nickname-inline-save {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  font-size: 21rpx;
  font-weight: 700;
}

.nickname-inline-cancel {
  color: var(--color-muted);
}

.nickname-inline-save {
  color: var(--color-green-dark);
}
