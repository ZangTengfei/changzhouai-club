<view class="page-shell profile-view-page">
  <view wx:if="{{loading}}" class="empty-state loading-state"><view class="loading-spinner" aria-hidden="true"></view><text>正在加载成员名片</text></view>
  <view wx:elif="{{loadFailed}}" class="empty-state retry-state">
    <text class="retry-icon">↻</text>
    <text class="retry-title">暂时无法打开这张名片</text>
    <text class="retry-copy">资料可能已停止公开，也可能是网络开了小差</text>
    <button class="retry-button" bindtap="loadPage">重新加载</button>
  </view>

  <block wx:elif="{{profile}}">
    <view class="profile-view-hero">
      <view class="shared-profile-brand">
        <image src="/assets/logo-mark.png" mode="aspectFit" />
        <view class="shared-profile-brand-copy">
          <text class="shared-profile-brand-name">常州 AI Club</text>
          <text class="shared-profile-brand-caption">社区成员名片</text>
        </view>
      </view>
      <view class="profile-view-identity">
        <image wx:if="{{profile.avatarUrl}}" class="profile-view-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-view-avatar profile-view-avatar-empty">{{avatarInitial}}</view>
        <view class="profile-view-title">
          <text class="profile-view-name">{{profile.displayName}}</text>
          <text class="profile-view-role">{{profile.roleLabel}}{{profile.organization ? ' · ' + profile.organization : ''}}</text>
          <text class="profile-view-location">{{profile.city}}</text>
        </view>
      </view>
      <view class="profile-view-status"><text>{{profile.identityLabel}}</text><text>公开成员名片</text></view>
    </view>

    <view wx:if="{{profile.bio}}" class="profile-view-intro">{{profile.bio}}</view>

    <view class="profile-view-section">
      <view class="profile-view-section-heading"><text class="profile-view-index">01</text><text class="section-title">行业与能力</text></view>
      <view wx:if="{{profile.industryTags.length}}" class="profile-view-field"><text class="profile-view-label">所在行业</text><view class="profile-view-tags"><text wx:for="{{profile.industryTags}}" wx:key="*this">{{item}}</text></view></view>
      <view wx:if="{{profile.skills.length}}" class="profile-view-field"><text class="profile-view-label">擅长方向</text><view class="profile-view-tags"><text wx:for="{{profile.skills}}" wx:key="*this">{{item}}</text></view></view>
    </view>

    <view class="profile-view-section profile-view-section-blue">
      <view class="profile-view-section-heading"><text class="profile-view-index">02</text><text class="section-title">连接方向</text></view>
      <view wx:if="{{profile.capabilitySummary}}" class="profile-view-field"><text class="profile-view-label">我能提供</text><text class="profile-view-copy">{{profile.capabilitySummary}}</text></view>
      <view wx:if="{{profile.seekingSummary}}" class="profile-view-field"><text class="profile-view-label">我正在寻找</text><text class="profile-view-copy">{{profile.seekingSummary}}</text></view>
    </view>

    <view wx:if="{{profile.interests.length || preferenceLabels.length}}" class="profile-view-section profile-view-section-purple">
      <view class="profile-view-section-heading"><text class="profile-view-index">03</text><text class="section-title">参与方式</text></view>
      <view wx:if="{{profile.interests.length}}" class="profile-view-field"><text class="profile-view-label">感兴趣的方向</text><view class="profile-view-tags profile-view-tags-purple"><text wx:for="{{profile.interests}}" wx:key="*this">{{item}}</text></view></view>
      <view wx:if="{{preferenceLabels.length}}" class="profile-view-field"><text class="profile-view-label">参与意愿</text><view class="profile-view-tags profile-view-tags-purple"><text wx:for="{{preferenceLabels}}" wx:key="*this">{{item}}</text></view></view>
    </view>

    <view class="profile-view-privacy shared-profile-notice"><text>这是成员主动公开的社区名片</text><text>微信号和账号信息不会展示。</text></view>

    <view class="profile-view-actions">
      <button class="primary-button" open-type="share">转发这张名片</button>
    </view>

    <canvas type="2d" id="shared-profile-share-canvas" class="profile-share-canvas" aria-hidden="true"></canvas>
  </block>
</view>
