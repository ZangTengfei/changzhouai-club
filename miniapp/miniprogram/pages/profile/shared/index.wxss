@import "../index.wxss";

.shared-profile-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid rgba(20, 122, 91, 0.12);
}

.shared-profile-brand image {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
}

.shared-profile-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.shared-profile-brand-name {
  color: var(--color-green-dark);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
}

.shared-profile-brand-caption {
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.25;
}

.shared-profile-notice {
  margin-bottom: 12rpx;
}

.shared-profile-status {
  align-items: flex-end;
}

.shared-profile-community-labels {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  gap: 8rpx;
}

.shared-profile-community-labels text {
  padding: 5rpx 10rpx;
  border-radius: 14rpx;
  background: #fff5df;
  color: #8a5b17;
  font-size: 18rpx;
  line-height: 1.35;
}

.shared-profile-community-labels .shared-profile-community-identity {
  background: #ffffff;
  color: var(--color-green-dark);
}

.shared-profile-context {
  flex: none;
  color: var(--color-subtle);
  font-size: 19rpx;
  font-weight: 650;
}
