.basic-profile-page {
  padding-top: 34rpx;
}

.basic-profile-content {
  display: flex;
  flex-direction: column;
}

.basic-profile-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 28rpx;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.avatar-picker {
  display: flex;
  min-height: 142rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 22rpx;
  margin: 0;
  padding: 20rpx;
  border-radius: 26rpx;
  background: var(--color-green-soft);
  text-align: left;
}

.avatar-picker::after {
  border: 0;
}

.avatar-preview {
  display: flex;
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #ffffff;
}

.avatar-empty {
  color: var(--color-green-dark);
  font-size: 34rpx;
  font-weight: 800;
}

.avatar-copy,
.name-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.avatar-title,
.field-label {
  font-size: 27rpx;
  font-weight: 760;
}

.avatar-action {
  color: var(--color-green-dark);
  font-size: 22rpx;
}

.name-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 22rpx;
  background: #f8faf9;
  font-size: 29rpx;
}

.privacy-note {
  margin-top: 22rpx;
  color: var(--color-subtle);
  font-size: 22rpx;
  line-height: 1.6;
}

.privacy-link {
  color: var(--color-green-dark);
}

.save-button {
  width: 100%;
  margin-top: 30rpx;
}
