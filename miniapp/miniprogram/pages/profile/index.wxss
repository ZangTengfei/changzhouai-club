.profile-view-page {
  padding-top: 28rpx;
}

.profile-view-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 30rpx;
  border: 2rpx solid #dcefe5;
  border-radius: 34rpx;
  background: var(--color-green-soft);
}

.profile-view-identity {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-view-avatar {
  display: flex;
  width: 118rpx;
  height: 118rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #ffffff;
}

.profile-view-avatar-empty {
  color: var(--color-green-dark);
  font-size: 36rpx;
  font-weight: 800;
}

.profile-view-title {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.profile-view-name {
  font-size: 38rpx;
  font-weight: 820;
}

.profile-view-role {
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.45;
}

.profile-view-location {
  color: var(--color-green-dark);
  font-size: 22rpx;
  font-weight: 680;
}

.profile-view-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(20, 122, 91, 0.12);
  color: var(--color-green-dark);
  font-size: 22rpx;
  font-weight: 700;
}

.profile-view-intro,
.profile-view-privacy {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: var(--color-yellow-soft);
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.profile-view-section {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 28rpx;
  border: 2rpx solid #dcefe5;
  border-radius: 30rpx;
  background: #ffffff;
}

.profile-view-section-blue {
  border-color: #d9e9ff;
  background: var(--color-blue-soft);
}

.profile-view-section-purple {
  border-color: #e3ddff;
  background: var(--color-purple-soft);
}

.profile-view-section-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.profile-view-index {
  color: var(--color-green-dark);
  font-size: 21rpx;
  font-weight: 800;
}

.profile-view-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-view-label {
  color: var(--color-subtle);
  font-size: 21rpx;
  font-weight: 720;
}

.profile-view-copy {
  font-size: 26rpx;
  line-height: 1.65;
}

.profile-view-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.profile-view-tags text {
  display: inline-flex;
  min-height: 54rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 27rpx;
  background: var(--color-green-soft);
  color: var(--color-green-dark);
  font-size: 22rpx;
  font-weight: 680;
}

.profile-view-tags-purple text {
  background: rgba(255, 255, 255, 0.76);
  color: var(--color-purple);
}

.profile-view-privacy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: #f5f7f6;
  font-size: 22rpx;
}

.profile-view-actions {
  display: flex;
  position: sticky;
  z-index: 10;
  bottom: 0;
  gap: 16rpx;
  margin: 28rpx -32rpx -64rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-line);
  background: rgba(255, 255, 255, 0.96);
}

.profile-view-actions .primary-button,
.profile-view-actions .secondary-button {
  min-width: 0;
  min-height: 92rpx;
  flex: 1;
}

.profile-share-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  width: 750px;
  height: 600px;
  pointer-events: none;
}
