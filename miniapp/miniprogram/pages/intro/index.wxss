.intro-page {
  padding-top: 24rpx;
}

.intro-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.intro-hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 30rpx;
  border: 2rpx solid #d8eee2;
  border-radius: 32rpx;
  background: var(--color-green-soft);
}

.intro-kicker {
  color: var(--color-green-dark);
  font-size: 22rpx;
  font-weight: 760;
  letter-spacing: 2rpx;
}

.intro-summary {
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.intro-form {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 28rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 760;
}

.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-line);
  border-radius: 20rpx;
  background: #fbfdfc;
  font-size: 27rpx;
}

.field-input {
  min-height: 86rpx;
  padding: 0 22rpx;
}

.field-textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.privacy-link {
  color: var(--color-green-dark);
  font-weight: 700;
}

.privacy-note {
  margin-top: -14rpx;
  color: var(--color-subtle);
  font-size: 21rpx;
  line-height: 1.55;
}

.preview-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border: 2rpx solid #e2dafd;
  border-radius: 30rpx;
  background: var(--color-purple-soft);
}

.preview-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.preview-heading text:first-child {
  font-size: 28rpx;
  font-weight: 800;
}

.preview-heading text:last-child {
  color: var(--color-purple);
  font-size: 21rpx;
  font-weight: 720;
}

.preview-copy {
  color: var(--color-ink);
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.share-entry-button {
  border-color: #dcd2ff;
  color: #5c43c7;
}

.action-note {
  color: var(--color-subtle);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
