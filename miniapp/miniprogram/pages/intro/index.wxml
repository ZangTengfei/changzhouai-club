<view class="page-shell intro-page">
  <view wx:if="{{loading}}" class="empty-state loading-state"><view class="loading-spinner" aria-hidden="true"></view><text>正在加载你的资料</text></view>
  <view wx:elif="{{loadFailed}}" class="empty-state retry-state">
    <text class="retry-title">资料加载失败</text>
    <text class="retry-copy">请检查网络后重新加载</text>
    <button class="retry-button" bindtap="loadPage">重新加载</button>
  </view>

  <view wx:else class="intro-content">
    <view class="intro-hero">
      <text class="intro-kicker">60 秒完成</text>
      <text class="section-title">群内自我介绍</text>
      <text class="intro-summary">自愿填写并保存到你的成员资料，系统会生成一段可以直接粘贴到微信群的介绍。</text>
    </view>

    <view class="intro-form surface-card">
      <label class="form-field"><text class="field-label">姓名 / 昵称 *</text><input class="field-input" maxlength="60" value="{{displayName}}" data-field="displayName" bindinput="handleInput" placeholder="大家怎么称呼你" /></label>
      <label class="form-field"><text class="field-label">微信号 *</text><input class="field-input" maxlength="80" value="{{wechat}}" data-field="wechat" bindinput="handleInput" placeholder="仅用于社区联系，不进入介绍" /></label>
      <label class="form-field"><text class="field-label">所在城市 / 常州辖区 *</text><input class="field-input" maxlength="40" value="{{city}}" data-field="city" bindinput="handleInput" placeholder="例如：常州新北区" /></label>
      <label class="form-field"><text class="field-label">当前身份 *</text><input class="field-input" maxlength="80" value="{{roleLabel}}" data-field="roleLabel" bindinput="handleInput" placeholder="例如：产品经理、开发者、创业者" /></label>
      <label class="form-field"><text class="field-label">目前行业 *</text><input class="field-input" maxlength="160" value="{{industryText}}" data-field="industryText" bindinput="handleInput" placeholder="多个行业可用逗号分隔" /></label>
      <label class="form-field"><text class="field-label">自己的产品 / 项目 / 品牌</text><textarea class="field-textarea" maxlength="500" value="{{projectSummary}}" data-field="projectSummary" bindinput="handleInput" placeholder="选填，简单说说你正在做什么" /></label>
      <label class="form-field"><text class="field-label">目前对 AI 的核心需求 *</text><textarea class="field-textarea" maxlength="130" value="{{aiNeed}}" data-field="aiNeed" bindinput="handleInput" placeholder="尽量写一个当前最想解决的具体问题" /></label>
      <label class="form-field"><text class="field-label">想认识哪类 AI 伙伴 *</text><textarea class="field-textarea" maxlength="130" value="{{connectionTarget}}" data-field="connectionTarget" bindinput="handleInput" placeholder="例如：制造业 AI 落地、懂销售的伙伴" /></label>
      <label class="form-field"><text class="field-label">我能提供什么</text><textarea class="field-textarea" maxlength="300" value="{{capabilitySummary}}" data-field="capabilitySummary" bindinput="handleInput" placeholder="选填，例如：行业场景、技术经验、渠道资源" /></label>

      <checkbox-group bindchange="handlePrivacyChange">
        <label class="privacy-row"><checkbox value="accepted" checked="{{privacyAccepted}}" color="#147a5b" /><text>我同意保存以上资料，并已阅读</text><text class="privacy-link" catchtap="openPrivacy">隐私说明</text></label>
      </checkbox-group>
      <text class="privacy-note">微信号不会出现在复制的介绍里，也不会在公开成员页面展示。</text>
    </view>

    <view class="preview-card">
      <view class="preview-heading"><text>介绍预览</text><text>{{saved ? '已保存' : '编辑中'}}</text></view>
      <text class="preview-copy" user-select="true">{{introText}}</text>
    </view>

    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAndCopy">保存并复制介绍</button>
    <button class="secondary-button share-entry-button" open-type="share">把填写入口发给朋友</button>
    <text class="action-note">复制后返回微信，粘贴到群里发送即可。</text>
  </view>
</view>
