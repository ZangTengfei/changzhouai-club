<view class="page-shell growth-page">
  <view wx:if="{{loading}}" class="empty-state loading-state"><view class="loading-spinner" aria-hidden="true"></view><text>正在加载成长档案</text></view>
  <view wx:elif="{{loginRequired}}" class="empty-state retry-state">
    <view class="growth-guest-icon"><image src="/assets/icons/growth-purple-v2.png" mode="aspectFit" /></view>
    <text class="retry-title">登录后查看成长档案</text>
    <text class="retry-copy">查看你的成员身份、真实参与记录和社区标签。</text>
    <button class="primary-button growth-login-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="handleLogin">{{loggingIn ? '登录中' : '微信登录并查看'}}</button>
    <text wx:if="{{loginFailed}}" class="growth-login-error">登录没有完成，请检查网络后重试。</text>
    <text wx:if="{{loginRequestId}}" class="growth-login-diagnostic">诊断编号：{{loginRequestId}}</text>
  </view>
  <view wx:elif="{{loadFailed}}" class="empty-state" bindtap="loadGrowth">成长档案加载失败，轻触重试</view>

  <block wx:elif="{{user}}">
    <view class="growth-intro"><text>每一次真实参与，都会成为你的社区足迹。</text></view>
    <view class="growth-identity">
      <image class="level-badge" src="{{currentLevelAsset}}" mode="aspectFit" />
      <view class="growth-identity-copy">
        <text class="growth-kicker">成员身份</text>
        <text class="growth-level">{{user.identityLabel}}</text>
        <text class="growth-member">成长等级 {{currentLevelLabel}} · {{joinedLabel}}</text>
      </view>
    </view>

    <view class="growth-stats">
      <view class="stat-item"><text class="stat-value">{{user.stats.registrationCount}}</text><text class="stat-label">活动报名</text></view>
      <view class="stat-item"><text class="stat-value">{{user.stats.attendanceCount}}</text><text class="stat-label">实际到场</text></view>
      <view class="stat-item"><text class="stat-value">{{communityTags.length}}</text><text class="stat-label">社区标签</text></view>
    </view>

    <view class="growth-section">
      <view class="section-heading">
        <text class="section-title">身份成长</text>
        <text class="section-note">当前 {{currentLevelLabel}} · 下一阶段 {{nextLevelLabel}}</text>
      </view>
      <view class="growth-path">
        <view wx:for="{{growthSteps}}" wx:key="label" class="growth-step {{item.stateClass}}">
          <image class="growth-step-badge-background" src="{{item.asset}}" mode="aspectFit" />
          <view class="growth-step-content">
            <text class="growth-step-index">身份 {{index + 1}}</text>
            <view class="growth-step-copy">
              <view class="growth-step-title-row"><text class="growth-step-label">{{item.label}}</text><text class="growth-step-state">{{item.stateLabel}}</text></view>
              <text class="growth-step-description">{{item.description}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="growth-section">
      <view class="section-heading">
        <text class="section-title">社区标签</text>
        <text class="section-note">社区角色与真实贡献</text>
      </view>
      <view wx:if="{{communityTags.length}}" class="honor-list">
        <view wx:for="{{communityTags}}" wx:key="code" class="honor-row">
          <image src="/assets/logo-mark.png" mode="aspectFit" />
          <view class="honor-copy"><text class="honor-name">{{item.label}}</text><text class="honor-description">{{item.description}}</text></view>
        </view>
      </view>
      <view wx:else class="honor-empty">社区标签会根据成员职责与真实贡献逐步记录。</view>
    </view>
  </block>
</view>
