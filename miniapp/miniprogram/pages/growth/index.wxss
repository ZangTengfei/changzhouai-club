.growth-page {
  padding-top: 24rpx;
}

.growth-guest-icon {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: var(--color-purple-soft);
}

.growth-guest-icon image {
  width: 62rpx;
  height: 62rpx;
}

.growth-login-button {
  width: 100%;
  margin-top: 8rpx;
}

.growth-login-error {
  color: #b54708;
  font-size: 24rpx;
  line-height: 1.5;
}

.growth-login-diagnostic {
  color: #66756e;
  font-family: monospace;
  font-size: 21rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.growth-intro {
  margin-bottom: 22rpx;
  color: var(--color-subtle);
  font-size: 26rpx;
  line-height: 1.55;
}

.growth-identity {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx;
  border: 2rpx solid #dcefe5;
  border-radius: 36rpx;
  background: var(--color-green-soft);
}

.level-badge {
  width: 150rpx;
  height: 150rpx;
  flex: 0 0 auto;
}

.growth-identity-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.growth-kicker {
  color: var(--color-green-dark);
  font-size: 22rpx;
  font-weight: 720;
}

.growth-level {
  font-size: 40rpx;
  font-weight: 830;
  line-height: 1.25;
}

.growth-member {
  color: var(--color-subtle);
  font-size: 23rpx;
  line-height: 1.5;
}

.growth-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22rpx;
  padding: 26rpx 10rpx;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.stat-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-right: 2rpx solid var(--color-line);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 830;
}

.stat-label {
  color: var(--color-subtle);
  font-size: 21rpx;
}

.growth-section {
  margin-top: 30rpx;
  padding: 28rpx;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: #ffffff;
}

.growth-section:nth-of-type(4) {
  border-color: #f1e3ac;
  background: var(--color-yellow-soft);
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-bottom: 24rpx;
}

.section-note {
  color: var(--color-subtle);
  font-size: 22rpx;
}

.growth-path,
.honor-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.growth-step {
  position: relative;
  min-height: 164rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 22rpx 184rpx 22rpx 22rpx;
  border: 2rpx solid #e4ece8;
  border-radius: 28rpx;
  background: #f8faf9;
}

.growth-step-complete {
  border-color: #b9dfca;
  background: var(--color-green-soft);
  box-shadow: inset 8rpx 0 0 #38a56d;
}

.growth-step-current {
  border: 4rpx solid #338667;
  background: linear-gradient(135deg, #e3f7eb 0%, #edf5ff 100%);
  box-shadow: 0 12rpx 28rpx rgba(20, 122, 91, 0.16);
}

.growth-step-locked {
  border-color: #e1e4e3;
  background: #f3f5f4;
}

.growth-step-badge-background {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 132rpx;
  height: 132rpx;
  opacity: 0.38;
}

.growth-step-current .growth-step-badge-background {
  width: 136rpx;
  height: 136rpx;
  opacity: 0.62;
}

.growth-step-locked .growth-step-badge-background {
  opacity: 0.1;
  filter: grayscale(1);
}

.growth-step-content {
  display: flex;
  position: relative;
  z-index: 1;
  min-width: 0;
  flex-direction: column;
  gap: 14rpx;
}

.growth-step-index {
  color: var(--color-subtle);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.growth-step-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.growth-step-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.growth-step-label {
  font-size: 32rpx;
  font-weight: 820;
  line-height: 1.25;
}

.growth-step-description {
  color: var(--color-subtle);
  font-size: 22rpx;
  line-height: 1.45;
}

.growth-step-state {
  display: inline-flex;
  min-height: 42rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 21rpx;
  background: #ffffff;
  color: var(--color-green-dark);
  font-size: 20rpx;
  font-weight: 760;
  white-space: nowrap;
}

.growth-step-current .growth-step-state {
  background: var(--color-green);
  color: #ffffff;
}

.growth-step-locked .growth-step-state {
  border: 2rpx solid #d5d9d7;
  background: #e7eae8;
  color: #77807c;
}

.growth-step-locked .growth-step-label,
.growth-step-locked .growth-step-description,
.growth-step-locked .growth-step-index {
  color: #89918e;
}

.honor-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.76);
}

.honor-row image {
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 auto;
}

.honor-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.honor-name {
  font-size: 27rpx;
  font-weight: 780;
}

.honor-description,
.honor-empty {
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.honor-empty {
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.7);
}
