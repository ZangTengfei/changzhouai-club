.consent-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 24rpx;
}

.consent-hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 30rpx;
  border: 2rpx solid #d8eee2;
  border-radius: 32rpx;
  background: var(--color-green-soft);
}

.consent-kicker {
  color: var(--color-green-dark);
  font-size: 22rpx;
  font-weight: 760;
}

.consent-title {
  font-size: 40rpx;
  font-weight: 820;
  line-height: 1.35;
}

.consent-summary,
.consent-copy {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.72;
}

.consent-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(17, 23, 21, 0.04);
  border-radius: 28rpx;
}

.consent-section-green {
  background: var(--color-green-soft);
}

.consent-section-purple {
  background: var(--color-purple-soft);
}

.consent-section-orange {
  background: var(--color-orange-soft);
}

.consent-section-blue {
  background: var(--color-blue-soft);
}

.consent-section-yellow {
  background: var(--color-yellow-soft);
}

.consent-index {
  color: var(--color-green-dark);
  font-size: 20rpx;
  font-weight: 780;
}

.consent-heading {
  font-size: 29rpx;
  font-weight: 800;
}

.consent-version {
  padding: 10rpx 0 20rpx;
  color: var(--color-subtle);
  font-size: 21rpx;
  text-align: center;
}
