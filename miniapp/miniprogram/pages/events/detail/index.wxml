<view class="detail-page">
  <view wx:if="{{loading}}" class="page-shell"><view class="empty-state loading-state"><view class="loading-spinner" aria-hidden="true"></view><text>正在加载活动</text></view></view>
  <view wx:elif="{{loadFailed}}" class="page-shell">
    <view class="empty-state retry-state">
      <text class="retry-icon">↻</text>
      <text class="retry-title">暂时无法打开这个活动</text>
      <text class="retry-copy">网络可能开了个小差，请重新加载</text>
      <button class="retry-button" bindtap="retryLoad" aria-label="重新加载活动详情">重新加载</button>
    </view>
  </view>

  <view wx:elif="{{event}}" class="page-shell detail-content">
    <view class="detail-hero surface-card">
      <image wx:if="{{event.imageUrl}}" class="detail-cover" src="{{event.imageThumbnailUrl || event.imageUrl}}" mode="{{coverMode}}" />
      <view wx:else class="detail-cover detail-cover-placeholder"><image src="/assets/logo-mark.png" mode="aspectFit" /></view>
      <view class="detail-header">
        <text class="status-tag">{{event.eventTypeLabel}} · {{event.statusLabel}}</text>
        <text wx:if="{{registrationStatusLabel}}" class="registration-status-tag registration-status-tag-{{registrationStatusTone}}">{{registrationStatusLabel}}</text>
        <text class="detail-title">{{event.title}}</text>
        <text wx:if="{{event.summary}}" class="detail-summary">{{event.summary}}</text>
      </view>
    </view>

    <view class="fact-band">
      <view class="fact-row fact-row-orange"><view class="icon-tile"><image src="/assets/icons/events-orange-v2.png" mode="aspectFit" /></view><view class="fact-copy"><text class="fact-label">时间</text><text class="fact-value">{{event.dateTimeLabel}}</text></view></view>
      <view wx:if="{{event.locationLatitude != null && event.locationLongitude != null}}" class="fact-row fact-row-blue fact-row-action" role="button" aria-label="在地图中打开活动地点" bindtap="openEventLocation"><view class="icon-tile"><image src="/assets/icons/location-blue-v2.png" mode="aspectFit" /></view><view class="fact-copy"><text class="fact-label">地点 · 打开地图</text><text class="fact-value">{{event.locationLabel}}</text></view><text class="fact-action-arrow">›</text></view>
      <view wx:else class="fact-row fact-row-blue"><view class="icon-tile"><image src="/assets/icons/location-blue-v2.png" mode="aspectFit" /></view><view class="fact-copy"><text class="fact-label">地点</text><text class="fact-value">{{event.locationLabel}}</text></view></view>
    </view>

    <view wx:if="{{event.registrationCount}}" class="participant-section surface-card">
      <view class="participant-heading">
        <view><text class="participant-kicker">一起参加</text><text class="participant-title">报名情况</text></view>
        <text class="participant-count">{{event.registrationCount}} 人已报名{{event.registrationMode === 'review' ? ' · ' + event.confirmedCount + ' 个席位已确认' : ''}}</text>
      </view>
      <view wx:if="{{event.participants.length}}" class="participant-grid">
        <view wx:for="{{event.participants}}" wx:key="shareHandle" wx:for-item="participant" class="participant-item" data-handle="{{participant.shareHandle}}" bindtap="openParticipantProfile" role="button" aria-label="查看{{participant.displayName}}的成员资料">
          <image wx:if="{{participant.avatarUrl}}" class="participant-avatar" src="{{participant.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="participant-avatar participant-avatar-empty">{{participant.avatarInitial}}</view>
          <text class="participant-name">{{participant.displayName}}</text>
        </view>
        <view wx:if="{{event.confirmedCount > event.participants.length}}" class="participant-more">还有 {{event.confirmedCount - event.participants.length}} 人</view>
      </view>
      <text wx:else class="participant-pending-copy">报名申请正在确认中，确认后会展示参与者头像。</text>
    </view>

    <view wx:if="{{event.recapParagraphs.length}}" class="detail-section detail-section-green">
      <view class="record-heading"><text class="record-number">01</text><text class="section-title">活动回顾</text></view>
      <text wx:for="{{event.recapParagraphs}}" wx:key="*this" class="paragraph">{{item}}</text>
    </view>

    <view wx:if="{{event.video}}" class="detail-section detail-section-blue">
      <view class="record-heading"><text class="record-number">02</text><text class="section-title">现场视频</text></view>
      <video class="event-video" src="{{event.video.url}}" poster="{{event.video.coverUrl}}" title="{{event.video.title || event.title}}" controls></video>
    </view>

    <view wx:if="{{event.gallery.length}}" class="detail-section detail-section-orange">
      <view class="detail-section-heading">
        <view class="record-heading"><text class="record-number">03</text><text class="section-title">现场记录</text></view>
        <text class="section-count">{{event.gallery.length}} 张</text>
      </view>
      <view class="gallery-grid">
        <image wx:for="{{event.gallery}}" wx:key="id" class="gallery-image" src="{{item.thumbnailUrl || item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" data-url="{{item.imageUrl}}" bindtap="previewGalleryImage" />
      </view>
    </view>

    <view wx:if="{{event.descriptionParagraphs.length}}" class="detail-section detail-section-purple">
      <view class="record-heading"><text class="record-number">04</text><text class="section-title">活动介绍</text></view>
      <text wx:for="{{event.descriptionParagraphs}}" wx:key="*this" class="paragraph">{{item}}</text>
    </view>

    <view wx:if="{{event.agendaItems.length}}" class="detail-section detail-section-blue">
      <view class="record-heading"><text class="record-number">05</text><text class="section-title">活动流程</text></view>
      <view wx:for="{{event.agendaItems}}" wx:key="*this" class="list-row"><text class="list-index">{{index + 1}}</text><text class="list-text">{{item}}</text></view>
    </view>

    <view wx:if="{{event.registrationNote}}" class="registration-note">{{event.registrationNote}}</view>

    <view class="resource-actions">
      <button wx:if="{{event.docsUrl}}" class="secondary-button resource-button" bindtap="copyDocsLink">复制活动资料链接</button>
      <button class="secondary-button share-button" open-type="share">分享活动</button>
    </view>

    <view wx:if="{{event.status === 'scheduled'}}" class="registration-panel">
      <block wx:if="{{event.registrationUrl}}">
        <text class="registration-kicker">活动报名</text>
        <text class="registration-title">外部活动报名</text>
        <text class="registration-copy">该活动使用外部报名入口，复制链接后在浏览器打开。</text>
        <button class="primary-button" bindtap="copyExternalLink">复制报名链接</button>
      </block>
      <block wx:elif="{{registrationLoading}}"><text class="registration-copy">正在检查报名状态</text></block>
      <block wx:elif="{{registration && registration.status === 'registered'}}">
        <text class="registration-kicker">报名状态</text>
        <text class="registration-title">已报名</text>
        <text class="registration-copy">活动开始前可以在“我的活动”中再次查看。</text>
        <view wx:if="{{groupQr}}" class="group-qr-card">
          <text class="group-qr-title">加入活动微信群</text>
          <text class="group-qr-copy">{{groupQr.note || '请长按或点击二维码，用微信扫码加入本场活动群。'}}</text>
          <image class="group-qr-image" src="{{groupQr.imageUrl}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="previewGroupQr" />
        </view>
        <button wx:if="{{reminder && reminder.available && (!reminder.subscription || reminder.subscription.status !== 'accepted')}}" class="primary-button" loading="{{reminderSubmitting}}" disabled="{{reminderSubmitting}}" bindtap="enableReminder">开启活动提醒</button>
        <view wx:elif="{{reminder && reminder.subscription && reminder.subscription.status === 'accepted'}}" class="reminder-status">活动提醒已开启</view>
        <button class="secondary-button" loading="{{checkinSubmitting}}" disabled="{{checkinSubmitting}}" bindtap="scanCheckinCode">{{attendance ? '已签到' : '扫码签到'}}</button>
        <button wx:if="{{!attendance || !attendance.checked_in_at}}" class="secondary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="cancelRegistration">取消报名</button>
        <text wx:else class="registration-copy">已完成签到，报名与到场记录已锁定。</text>
      </block>
      <block wx:elif="{{registration && registration.status === 'pending'}}">
        <text class="registration-kicker">报名状态</text>
        <text class="registration-title">报名待审核</text>
        <text class="registration-copy">申请已提交，组织方确认后会更新为“已报名”。</text>
        <button class="secondary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="cancelRegistration">取消申请</button>
      </block>
      <block wx:elif="{{registration && registration.status === 'waitlisted'}}">
        <text class="registration-kicker">报名状态</text>
        <text class="registration-title">候补中</text>
        <text class="registration-copy">当前确认名额已满，组织方调整名额后可将你转为已报名。</text>
        <button class="secondary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="cancelRegistration">取消候补</button>
      </block>
      <block wx:elif="{{!user}}">
        <text class="registration-kicker">活动报名</text>
        <text class="registration-title">登录后继续报名</text>
        <text class="registration-copy">登录只用于识别社区账号，完成后会返回当前活动。</text>
        <button class="primary-button" bindtap="openProfile">微信登录</button>
      </block>
      <block wx:elif="{{!basicProfileReady}}">
        <text class="registration-kicker">活动报名</text>
        <text class="registration-title">先设置个人信息</text>
        <text class="registration-copy">请设置社区伙伴称呼你的昵称；头像可以稍后补充。</text>
        <button class="primary-button" bindtap="openProfile">设置昵称</button>
      </block>
      <block wx:elif="{{!user.capabilityProfileComplete}}">
        <text class="registration-kicker">活动报名</text>
        <text class="registration-title">完善社区名片后报名</text>
        <text class="registration-copy">补充城市、身份、行业、能力与连接方向，完成后会返回当前活动。</text>
        <button class="primary-button" bindtap="openProfile">去完善社区名片</button>
      </block>
      <block wx:else>
        <text class="registration-kicker">活动报名</text>
        <text class="registration-title">{{event.registrationMode === 'review' ? '提交报名申请' : '报名这场活动'}}</text>
        <text class="registration-copy">{{event.registrationCapacity ? '确认名额限 ' + event.registrationCapacity + ' 人' : '本场不限报名人数'}}{{event.registrationMode === 'review' ? '，提交后由组织方审核。' : '。'}}</text>
        <view class="registration-field-heading"><text>报名补充信息</text><text>{{event.registrationMode === 'review' ? '必填' : '选填'}}</text></view>
        <textarea class="registration-textarea" maxlength="500" value="{{registrationNote}}" bindinput="handleNoteInput" placeholder="{{event.registrationMode === 'review' ? '请简单说说你在做什么、目前做到哪一步，以及最想解决的问题' : '写下你特别想交流的话题'}}" />
        <text wx:if="{{event.registrationMode === 'review'}}" class="registration-field-help">我们会根据这段内容安排现场讨论和确认名额，请尽量写具体一些。</text>
        <checkbox-group class="registration-consents" bindchange="handleRegistrationConsentChange">
          <label class="registration-consent-row">
            <checkbox value="registration" checked="{{registrationConsentAccepted}}" color="#147a5b" />
            <view class="registration-consent-copy"><text>我已阅读并同意</text><text class="registration-consent-link" catchtap="openRegistrationConsent">《隐私协议》</text><text> *</text></view>
          </label>
        </checkbox-group>
        <button class="primary-button registration-submit-button {{!registrationConsentAccepted || (event.registrationMode === 'review' && !registrationNoteProvided) ? 'registration-submit-button-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting || !registrationConsentAccepted || (event.registrationMode === 'review' && !registrationNoteProvided)}}" bindtap="submitRegistration">{{event.registrationMode === 'review' ? '提交申请' : '确认报名'}}</button>
      </block>
    </view>

    <view wx:elif="{{event.status === 'draft'}}" class="registration-panel draft-preview-panel">
      <text class="registration-kicker">管理员预览</text>
      <text class="registration-title">活动尚未发布</text>
      <text class="registration-copy">草稿仅管理员可见，发布后才会向用户开放报名。</text>
    </view>

    <view wx:elif="{{event.status === 'completed'}}" class="completed-panel">
      <view class="completed-note">本场活动已结束，现场记录会持续补充。</view>
      <view wx:if="{{attendance}}" class="feedback-panel">
        <view class="feedback-heading"><text class="registration-title">活动反馈</text><text class="feedback-status">{{feedback ? '已提交，可继续修改' : '仅实际到场成员可填写'}}</text></view>
        <view class="rating-switch"><view wx:for="{{ratingOptions}}" wx:key="*this" class="rating-option {{feedbackRating === item ? 'rating-option-active' : ''}}" data-rating="{{item}}" bindtap="selectFeedbackRating">{{item}}</view></view>
        <view class="rating-caption"><text>需要改进</text><text>非常满意</text></view>
        <textarea class="registration-textarea" maxlength="500" value="{{feedbackComment}}" bindinput="handleFeedbackInput" placeholder="可选：留下一条建议" />
        <button class="primary-button" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting || !feedbackRating}}" bindtap="submitFeedback">保存反馈</button>
      </view>
    </view>
  </view>
</view>
